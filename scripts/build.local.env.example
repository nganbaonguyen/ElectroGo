# Sao chép file này thành scripts/build.local.env rồi điền giá trị (file đó đã được .gitignore).
# Dùng chung cho `pnpm build:ios` và `pnpm build:android`, khỏi phải gõ biến mỗi lần chạy.

# ── iOS ──
ELECTROGO_IOS_TEAM_ID=
# development (mặc định) | ad-hoc | app-store-connect | enterprise
ELECTROGO_IOS_EXPORT_METHOD=development
# ELECTROGO_IOS_BUNDLE_ID=com.example.electrogo

# ── GitHub Pages (KHUYÊN DÙNG): địa chỉ https cố định, app chạy ở mọi WiFi, không cần Mac bật ──
# Web phân phối tự đưa bundle lên Pages sau mỗi lần upload (khung "GitHub Pages" ở tab Bundle).
# Địa chỉ dạng https://<tên>.github.io/<repo>. Có biến này thì DEPLOY_API_URL bên dưới bị bỏ qua.
# DEPLOY_STATIC_URL=https://nganbaonguyen.github.io/electrogo-bundles

# ── Web phân phối bundle trong mạng LAN (chỉ khi không dùng Pages): app hỏi địa chỉ này xem bản LIVE ──
# Địa chỉ web mà ĐIỆN THOẠI truy cập được (không dùng localhost). Bỏ trống = script tự tìm (web đang chạy
# ở cổng 8080, hoặc IP LAN của máy). Đặt none = cố ý không dùng web (nạp từ địa chỉ cố định, chỉ dev).
# Địa chỉ http:// thì script tự bật cleartext cho Android. Bản phát hành thật nên dùng https.
# DEPLOY_API_URL=http://192.168.1.10:8080
# DEPLOY_APP_ID=electrogo
# DEPLOY_ENV=live

# ── OTA (pnpm code-push-live): token GitHub quyền Contents: Read and write cho repo ElectroGo ──
# Tạo ở https://github.com/settings/personal-access-tokens/new (Fine-grained, chỉ chọn repo ElectroGo).
# GITHUB_TOKEN=

# ── Android: khóa ký release (bắt buộc nếu muốn đưa AAB lên Google Play) ──
# ELECTROGO_KEYSTORE=/Users/<ban>/keys/electrogo-upload.jks
# ELECTROGO_KEYSTORE_PASSWORD=
# ELECTROGO_KEY_ALIAS=electrogo
# ELECTROGO_KEY_PASSWORD=

# ── Số phiên bản (tăng ELECTROGO_VERSION_CODE mỗi lần đưa lên store) ──
ELECTROGO_VERSION_NAME=1.0
ELECTROGO_VERSION_CODE=1
